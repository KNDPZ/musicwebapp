# HTTPS front door for the music app
# Configure SITE_ADDRESS with the public IP or DNS name used by clients.
{
	auto_https disable_redirects
	# Optional: set DEFAULT_SNI to your public IP or domain for cleaner certificates
	default_sni {$DEFAULT_SNI:localhost}
}

:80 {
	reverse_proxy 127.0.0.1:8788
}

https://{$SITE_ADDRESS:localhost} {
	tls {$TLS_ARGS:internal}
	reverse_proxy 127.0.0.1:8788 {
		header_up CF-Connecting-IP {remote_host}
		flush_interval -1
	}
}
