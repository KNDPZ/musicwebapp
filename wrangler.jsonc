{
  "$schema": "node_modules/wrangler/config-schema.json",
  // IMPORTANT: this name must match the Worker name in your Cloudflare Git build settings.
  "name": "music-app",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/audio/*"]
  },
  // No IDs on purpose: Wrangler creates these on first deploy and keeps them linked.
  "r2_buckets": [{ "binding": "MUSIC" }],
  "d1_databases": [{ "binding": "DB" }]
}
