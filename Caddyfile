# HTTPS front door for the music app (used by the "https" compose profile).
#
# All configuration comes from environment variables (see .env.example):
#   SITE_ADDRESS  Address(es) to listen on. Default: :443 (catch-all)
#   DEFAULT_SNI   Fallback name/IP when the client sends no SNI.
#   TLS_ARGS      "internal" (default) | "you@example.com" | "/certs/cert.pem /certs/key.pem"

{
	auto_https disable_redirects
	default_sni {$DEFAULT_SNI:localhost}
}

# Explicit catch-all. The double-colon form can be mis-parsed, so we use a clearer default.
:443 {
	tls {$TLS_ARGS:internal}

	reverse_proxy music-app:8787 {
		header_up CF-Connecting-IP {remote_host}
		flush_interval -1
	}
}
